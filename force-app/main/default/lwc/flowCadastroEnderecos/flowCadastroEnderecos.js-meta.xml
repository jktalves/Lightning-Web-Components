<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Cadastro de Endereços</masterLabel>
    <description>Wrapper do Flow Endereco_Cadastro. Detecta automaticamente o contexto (Conta ou Opportunity) via CurrentPageReference e passa o recordId para o Flow, garantindo o mesmo comportamento das Quick Actions quando usado na Utility Bar.</description>
    <targets>
        <!-- Utility Bar: uso principal deste componente -->
        <target>lightning__UtilityBar</target>
        <!-- App/Record/Home pages: uso secundário (App Builder) -->
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <!-- lightning__UtilityBar não aceita supportedFormFactors -->
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
